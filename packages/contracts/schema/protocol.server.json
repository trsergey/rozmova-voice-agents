{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerMessage",
  "$defs": {
    "AssistantDelta": {
      "additionalProperties": false,
      "description": "A streamed fragment of the assistant reply.",
      "properties": {
        "type": {
          "const": "assistant_delta",
          "default": "assistant_delta",
          "type": "string"
        },
        "turn_id": {
          "description": "1-based turn number within the call.",
          "minimum": 1,
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "turn_id",
        "text"
      ],
      "title": "AssistantDelta",
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "description": "A typed error. The connection stays open unless a session_end follows.",
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "type": "string"
        },
        "code": {
          "enum": [
            "invalid_message",
            "turn_timeout",
            "llm_unavailable",
            "tool_failed",
            "rate_limited",
            "internal"
          ],
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "retryable"
      ],
      "title": "Error",
      "type": "object"
    },
    "Handoff": {
      "additionalProperties": false,
      "description": "The call is transferred to a human operator.",
      "properties": {
        "type": {
          "const": "handoff",
          "default": "handoff",
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "title": "Handoff",
      "type": "object"
    },
    "HistoryMessage": {
      "additionalProperties": false,
      "description": "One rendered line of the conversation, sent when a session is resumed.",
      "properties": {
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "interrupted": {
          "default": false,
          "description": "The assistant reply was cut off by a new utterance.",
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "text",
        "interrupted"
      ],
      "title": "HistoryMessage",
      "type": "object"
    },
    "JsonValue": {},
    "NodeEnter": {
      "additionalProperties": false,
      "description": "The flow executor entered a node.",
      "properties": {
        "type": {
          "const": "node_enter",
          "default": "node_enter",
          "type": "string"
        },
        "node_id": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "node_id"
      ],
      "title": "NodeEnter",
      "type": "object"
    },
    "SessionEnd": {
      "additionalProperties": false,
      "description": "The session is closed.\n\n``shutdown`` means the gateway is restarting; the client may reconnect with the same\ncall_id and a new ticket.",
      "properties": {
        "type": {
          "const": "session_end",
          "default": "session_end",
          "type": "string"
        },
        "reason": {
          "enum": [
            "hangup",
            "timeout",
            "shutdown",
            "limit",
            "handoff",
            "completed"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "title": "SessionEnd",
      "type": "object"
    },
    "SessionStarted": {
      "additionalProperties": false,
      "description": "The session was created, or resumed with the same call_id.",
      "properties": {
        "type": {
          "const": "session_started",
          "default": "session_started",
          "type": "string"
        },
        "call_id": {
          "format": "uuid",
          "type": "string"
        },
        "bot_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Published version number; null for a draft."
        },
        "resumed": {
          "default": false,
          "type": "boolean"
        },
        "history": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/HistoryMessage"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Present only when resumed."
        }
      },
      "required": [
        "type",
        "call_id",
        "bot_version",
        "resumed",
        "history"
      ],
      "title": "SessionStarted",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "description": "A knowledge-base chunk cited in the reply as [marker].",
      "properties": {
        "marker": {
          "minimum": 1,
          "type": "integer"
        },
        "chunk_id": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "document_title": {
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "marker",
        "chunk_id",
        "document_id",
        "document_title",
        "section"
      ],
      "title": "Source",
      "type": "object"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "The engine invoked a tool.",
      "properties": {
        "type": {
          "const": "tool_call",
          "default": "tool_call",
          "type": "string"
        },
        "turn_id": {
          "description": "1-based turn number within the call.",
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "args": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      },
      "required": [
        "type",
        "turn_id",
        "name",
        "args"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "description": "The result of a tool invocation.",
      "properties": {
        "type": {
          "const": "tool_result",
          "default": "tool_result",
          "type": "string"
        },
        "turn_id": {
          "description": "1-based turn number within the call.",
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "type",
        "turn_id",
        "name",
        "result"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "TurnCancelled": {
      "additionalProperties": false,
      "description": "The turn was interrupted by a new utterance.",
      "properties": {
        "type": {
          "const": "turn_cancelled",
          "default": "turn_cancelled",
          "type": "string"
        },
        "turn_id": {
          "description": "1-based turn number within the call.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "turn_id"
      ],
      "title": "TurnCancelled",
      "type": "object"
    },
    "TurnEnd": {
      "additionalProperties": false,
      "description": "The turn finished.",
      "properties": {
        "type": {
          "const": "turn_end",
          "default": "turn_end",
          "type": "string"
        },
        "turn_id": {
          "description": "1-based turn number within the call.",
          "minimum": 1,
          "type": "integer"
        },
        "timings": {
          "$ref": "#/$defs/TurnTimings"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "type": "array"
        }
      },
      "required": [
        "type",
        "turn_id",
        "timings",
        "sources"
      ],
      "title": "TurnEnd",
      "type": "object"
    },
    "TurnTimings": {
      "additionalProperties": false,
      "description": "Where the turn spent its latency budget, in milliseconds.",
      "properties": {
        "total_ms": {
          "minimum": 0,
          "type": "number"
        },
        "ttft_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "From accepting user_text to the first assistant_delta; null if no text."
        },
        "stages": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Per-stage durations, e.g. state_load, embedding, search, llm_ttft, tools.",
          "type": "object"
        }
      },
      "required": [
        "total_ms",
        "ttft_ms",
        "stages"
      ],
      "title": "TurnTimings",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "assistant_delta": "#/$defs/AssistantDelta",
      "error": "#/$defs/Error",
      "handoff": "#/$defs/Handoff",
      "node_enter": "#/$defs/NodeEnter",
      "session_end": "#/$defs/SessionEnd",
      "session_started": "#/$defs/SessionStarted",
      "tool_call": "#/$defs/ToolCall",
      "tool_result": "#/$defs/ToolResult",
      "turn_cancelled": "#/$defs/TurnCancelled",
      "turn_end": "#/$defs/TurnEnd"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SessionStarted"
    },
    {
      "$ref": "#/$defs/AssistantDelta"
    },
    {
      "$ref": "#/$defs/ToolCall"
    },
    {
      "$ref": "#/$defs/ToolResult"
    },
    {
      "$ref": "#/$defs/NodeEnter"
    },
    {
      "$ref": "#/$defs/TurnEnd"
    },
    {
      "$ref": "#/$defs/TurnCancelled"
    },
    {
      "$ref": "#/$defs/Handoff"
    },
    {
      "$ref": "#/$defs/Error"
    },
    {
      "$ref": "#/$defs/SessionEnd"
    }
  ]
}
