# Copy to `.env` in the repo root: `cp .env.example .env`.
# Read by rozmova_core.settings.Settings (prefix ROZMOVA_). Values below match
# the local stack from `make up` (infra/compose.dev.yml). Never commit `.env`.

# --- Process ---------------------------------------------------------------
# Service name in logs and traces; each app overrides it (gateway, admin-api).
ROZMOVA_SERVICE_NAME=rozmova
# Deployment environment: local | test | dev | demo.
ROZMOVA_ENV=local

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR.
ROZMOVA_LOG_LEVEL=INFO
# true: structlog JSON lines; false: coloured console output for local work.
ROZMOVA_LOG_JSON=false

# --- PostgreSQL (pgvector) -------------------------------------------------
# SQLAlchemy async URL; the driver must be asyncpg.
ROZMOVA_DATABASE_URL=postgresql+asyncpg://rozmova:rozmova@localhost:5432/rozmova
ROZMOVA_DB_POOL_SIZE=10
ROZMOVA_DB_MAX_OVERFLOW=10
# Seconds to wait for a free pooled connection before failing.
ROZMOVA_DB_POOL_TIMEOUT_SECONDS=5

# --- Redis -----------------------------------------------------------------
ROZMOVA_REDIS_URL=redis://localhost:6379/0
ROZMOVA_REDIS_SOCKET_TIMEOUT_SECONDS=5
ROZMOVA_REDIS_MAX_CONNECTIONS=50

# --- Secrets (unset by default; set real values outside git) ---------------
# Left commented out: an empty value would be read as an empty secret, not as unset.
# Fernet key that encrypts provider API keys in the DB. Generate with:
#   openssl rand -base64 32 | tr '+/' '-_'
# ROZMOVA_FERNET_MASTER_KEY=
# HMAC secret that signs the short-lived WebSocket tickets (admin-api -> gateway).
# Generate with: openssl rand -hex 32
# ROZMOVA_TICKET_SECRET=
# Browser origins allowed to open the gateway WebSocket (JSON list). Clients without
# an Origin header (CLI, smoke tests) are not browsers and rely on the ticket alone.
ROZMOVA_ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:5173"]

# --- Tracing ---------------------------------------------------------------
# Standard OTel variable (no prefix). OTLP/HTTP base URL; traces go to Jaeger
# (UI: http://localhost:16686). Leave empty to disable trace export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
